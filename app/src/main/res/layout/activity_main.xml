<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background_modern"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Section with Glass Effect -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/glass_card"
            android:padding="32dp"
            android:elevation="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎤 Vicky AI"
                android:textSize="42sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:layout_marginBottom="12dp"
                android:shadowColor="#80000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="8" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Smart Voice Assistant"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:alpha="0.9"
                android:fontFamily="sans-serif-light" />
        </LinearLayout>

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_modern"
            android:padding="24dp"
            android:elevation="12dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="16dp"
                    android:indeterminateTint="#667eea"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvModelStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔄 Initializing..."
                    android:textSize="18sp"
                    android:textColor="#333333"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏸️ Ready to listen"
                android:textSize="16sp"
                android:textColor="#666666"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Auto-Answer Status -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📞 Auto-Answer: Enabled (10s delay)"
                android:textSize="15sp"
                android:textColor="#667eea"
                android:textStyle="bold"
                android:drawablePadding="8dp"
                android:padding="12dp"
                android:background="#F0F0FF"
                android:layout_marginBottom="12dp" />

            <!-- Notification Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="#F0FFF0">

                <TextView
                    android:id="@+id/tvNotificationStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔔 Notifications: Disabled"
                    android:textSize="15sp"
                    android:textColor="#11998e"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@android:color/white"
                    app:trackTint="#11998e" />
            </LinearLayout>
        </LinearLayout>

        <!-- Voice Control Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartListening"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:text="🎤 START"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/button_success"
                android:layout_marginEnd="12dp"
                android:elevation="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopListening"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:text="⏹️ STOP"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/button_danger"
                android:layout_marginStart="12dp"
                android:elevation="12dp" />
        </LinearLayout>

        <!-- Notification Settings Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotificationSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ Enable Notification Access"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_primary"
            android:layout_marginBottom="24dp"
            android:padding="18dp"
            android:elevation="8dp"
            android:visibility="gone" />

        <!-- Recognized Text Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_modern"
            android:padding="24dp"
            android:elevation="12dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💬 You Said:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvRecognizedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Say 'Vicky' to start..."
                android:textSize="20sp"
                android:textColor="#667eea"
                android:minHeight="100dp"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:padding="20dp"
                android:background="#F8F9FA" />
        </LinearLayout>

        <!-- Recent Notifications Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_modern"
            android:padding="24dp"
            android:elevation="12dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔔 Recent Notifications"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvRecentNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No notifications yet..."
                android:textSize="14sp"
                android:textColor="#666666"
                android:maxLines="5"
                android:ellipsize="end"
                android:padding="16dp"
                android:background="#F8F9FA" />
        </LinearLayout>

        <!-- Activity Log Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_modern"
            android:padding="24dp"
            android:elevation="12dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📋 Activity Log"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Clear"
                    android:textSize="13sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/button_danger"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginEnd="8dp"
                    style="?android:attr/buttonBarButtonStyle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Export"
                    android:textSize="13sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/button_primary"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    style="?android:attr/buttonBarButtonStyle" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#F8F9FA"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp" />
            </ScrollView>
        </LinearLayout>

        <!-- Commands Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_modern"
            android:padding="24dp"
            android:elevation="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Quick Commands"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• &quot;Vicky, what time is it?&quot;\n• &quot;Vicky, open WhatsApp&quot;\n• &quot;Vicky, flashlight on&quot;\n• &quot;Vicky, volume up&quot;\n• &quot;Vicky, what is AI?&quot;\n• &quot;Vicky, search for news&quot;\n\n📞 Auto-Answer Feature:\nIncoming calls are auto-answered after 10 seconds with a custom AI message, then automatically disconnected."
                android:textSize="14sp"
                android:textColor="#666666"
                android:lineSpacingExtra="6dp"
                android:padding="16dp"
                android:background="#F8F9FA" />
        </LinearLayout>

        <!-- Telegram Button (Optional) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTelegram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 Join Telegram @soulcrack"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/button_primary"
            android:layout_marginTop="24dp"
            android:padding="18dp"
            android:elevation="8dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
